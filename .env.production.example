# Copy to .env.production, then replace these values. Never commit real values.
CLOUDFLARE_ACCOUNT_ID=replace_with_your_32_character_account_id
FOLIO_D1_DATABASE_ID=replace_with_created_d1_database_uuid
FOLIO_DOMAIN=folio.your-domain.com
FOLIO_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
FOLIO_ACCESS_AUD=replace_with_access_application_64_character_aud
# Comma-separated allowed emails; all share the same vault.
FOLIO_ACCESS_EMAIL=you@your-domain.com
# Optional: run near a known storage region; otherwise use Smart Placement.
# FOLIO_PLACEMENT_REGION=aws:ap-east-1
# Authenticate CLI using `npx wrangler login`. Access mode needs no setup password/token.
