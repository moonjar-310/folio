{
  "name": "folio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/trunk.mjs serve --locked",
    "preview:dev": "node preview/server.mjs",
    "check": "cargo fmt --all --check && cargo check -p folio-web -p folio-worker --target wasm32-unknown-unknown --locked",
    "test": "cargo test --locked",
    "preview:test": "node --test tests/ui.test.mjs",
    "design:export": "node scripts/export-design.mjs",
    "app:build": "node scripts/trunk.mjs build --release --locked",
    "app:dev": "node scripts/trunk.mjs serve --locked",
    "app:local": "cargo run -p folio-local --locked",
    "app:check": "cargo check -p folio-web --target wasm32-unknown-unknown --locked",
    "app:test": "cargo test -p folio-web --locked",
    "worker:dev": "wrangler dev",
    "worker:migrate:local": "wrangler d1 migrations apply DB --local",
    "worker:check": "cargo check -p folio-worker --target wasm32-unknown-unknown --locked",
    "worker:package": "wrangler deploy --dry-run --outdir .local/worker-check",
    "test:api": "node scripts/smoke-product.mjs",
    "preview:check": "node --check preview/server.mjs && node --check ui/components.mjs && node --check ui/pages.mjs && node --check public/app.js"
  },
  "devDependencies": {
    "wrangler": "4.131.2"
  }
}
